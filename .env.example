# Copy this file to .env and fill it in. Never commit .env.

# REQUIRED. The organizer's password for the /admin page. Make up a long one.
# The app refuses to start without it.
BARGAMES_ADMIN_PASSWORD=

# Optional: override the title / badge / colour theme from app/seed/branding.json.
# Themes: default, dusk, noon.
BARGAMES_TITLE=
BARGAMES_BADGE=
BARGAMES_THEME=

# Port on this computer, and which network interface to listen on.
# 0.0.0.0 = reachable from other devices on your network (players' phones).
TRIVIA_PORT=8000
TRIVIA_BIND=0.0.0.0

# --- Only if you put the app behind HTTPS / a reverse proxy (README, "Playing
# --- away from home"). Leave as-is for a plain home-Wi-Fi setup.
# 1 = only send login cookies over HTTPS. Set to 1 when players use an https:// address.
BARGAMES_COOKIE_SECURE=0
# Cookie path. "/" unless your proxy serves the app under a sub-path such as
# /trivia and strips it before passing requests on; then set it to that path.
BARGAMES_COOKIE_PATH=/
# 1 = trust X-Forwarded-For / CF-Connecting-IP to identify callers (only when
# a proxy you control sits in front; otherwise callers could fake them).
BARGAMES_TRUST_PROXY=0
